# Local Postgres (docker compose service "db")
POSTGRES_USER=tenstats
POSTGRES_PASSWORD=tenstats
POSTGRES_DB=tenstats
POSTGRES_PORT=5432

# Read-write connection used by the ETL pipeline
DATABASE_URL=postgresql://tenstats:tenstats@db:5432/tenstats

# Read-only connection used by the web app (separate role in production)
DATABASE_URL_READONLY=postgresql://tenstats:tenstats@db:5432/tenstats
